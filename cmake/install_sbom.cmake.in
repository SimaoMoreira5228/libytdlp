set(LIBYTDLP_SBOM_SOURCE_DIR "@CMAKE_CURRENT_SOURCE_DIR@")
set(LIBYTDLP_SBOM_PYTHON "@Python_EXECUTABLE@")
set(LIBYTDLP_SBOM_RELPATH "@CMAKE_INSTALL_DATADIR@/libytdlp/sbom.json")

set(LIBYTDLP_SBOM_PREFIX "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(LIBYTDLP_SBOM_OUT "${LIBYTDLP_SBOM_PREFIX}/${LIBYTDLP_SBOM_RELPATH}")

get_filename_component(LIBYTDLP_SBOM_DIR "${LIBYTDLP_SBOM_OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${LIBYTDLP_SBOM_DIR}")

execute_process(
    COMMAND "${LIBYTDLP_SBOM_PYTHON}" "${LIBYTDLP_SBOM_SOURCE_DIR}/tools/sbom.py"
        --out "${LIBYTDLP_SBOM_OUT}"
    RESULT_VARIABLE LIBYTDLP_SBOM_RESULT
    OUTPUT_VARIABLE LIBYTDLP_SBOM_OUTPUT
    ERROR_VARIABLE LIBYTDLP_SBOM_OUTPUT
)

if(NOT LIBYTDLP_SBOM_RESULT EQUAL 0)
    message(FATAL_ERROR "sbom generation failed:\n${LIBYTDLP_SBOM_OUTPUT}")
endif()
